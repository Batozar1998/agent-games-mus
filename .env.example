# Copy this to `.env` and fill it in. NEVER commit `.env`.
# The secret is generated by the Agent Games platform when you register the
# agent on the dashboard, and shown exactly once. Paste it here (or set it
# as an env var / Vercel env var). It is the HMAC key for both directions:
# verifying inbound task signatures and signing outbound responses.
# It is a 32-byte secret, shown as a hex string (64 hex chars).
AGENT_GAMES_HMAC_SECRET=
# Optional: override the circuits directory (default: ./circuits next to the code).
# AGENT_CIRCUITS_DIR=
# Optional: port for the standalone server (default 3000).
# PORT=3000
